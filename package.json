{
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "check:questions": "node ./scripts/check-questions.mjs",
    "voice:clips": "node ./scripts/generate-voice-clips.mjs",
    "build": "npm run build:web",
    "build:web": "node ./scripts/build-web.mjs",
    "test:mobile": "playwright test tests/mobile-smoke.spec.ts --project=mobile-iphone13",
    "test:mobile:ui": "playwright test tests/mobile-smoke.spec.ts --project=mobile-iphone13 --ui",
    "cap:sync": "node ./scripts/cap.mjs sync",
    "cap:open:android": "node ./scripts/cap.mjs open-android",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "bank:build": "node scripts/create-learning-bank.mjs && node scripts/localize-learning-bank.mjs && node scripts/seed-learning-bank.mjs",
    "test:import": "python3 tests/question_import_test.py"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.58.2",
    "msedge-tts": "^2.0.5",
    "vite": "^7.3.1"
  }
}
