:root {
    --primary: #2563eb;
    --accent: #f59e0b;
    --bg: #f8fafc;
    --card-bg: #fff7ed; /* צהבהב לשאלות */
    --card-border: #fdba74;
}

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; user-select: none; }
body { margin: 0; padding: 0; background: #cbd5e1; font-family: system-ui, sans-serif; height: 100vh; overflow: hidden; display: flex; justify-content: center; }

.app-container {
    width: 100%; height: 100%; background: white; display: flex; flex-direction: column; position: relative;
}
@media (min-width: 600px) {
    .app-container { max-width: 480px; height: 95vh; margin-top: 2.5vh; border-radius: 20px; box-shadow: 0 20px 50px rgba(0,0,0,0.2); overflow: hidden; }
}

/* Header & Question */
.top-bar { padding: 10px; background: white; border-bottom: 1px solid #e2e8f0; z-index: 10; }
.controls-row { display: flex; gap: 8px; margin-bottom: 8px; }

.icon-btn { background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 50%; width: 40px; height: 40px; font-size: 18px; cursor: pointer; }
.next-btn { background: var(--primary); color: white; border: none; border-radius: 8px; padding: 0 12px; font-weight: bold; font-size: 14px; cursor: pointer; }

.select-wrapper { flex-grow: 1; }
select { width: 100%; height: 100%; padding: 0 10px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 16px; background: #fff; }

.question-card {
    background: var(--card-bg); border: 2px solid var(--card-border);
    border-radius: 12px; padding: 10px; display: flex; align-items: center; gap: 10px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05); transition: 0.3s;
}
.q-icon { font-size: 24px; }
.q-content h3 { margin: 0 0 2px; font-size: 14px; color: #9a3412; }
.q-content p { margin: 0; font-size: 13px; color: #431407; line-height: 1.2; }

/* Canvas Area */
.canvas-wrapper { flex: 1; position: relative; overflow: hidden; background: #fff; cursor: crosshair; }
canvas { width: 100%; height: 100%; display: block; }

.equation-float {
    position: absolute; top: 10px; left: 0; right: 0; text-align: center;
    font-family: "Times New Roman", serif; font-size: 22px; font-weight: bold;
    color: var(--primary); pointer-events: none; text-shadow: 0 2px 8px rgba(255,255,255,0.9);
}

.hud {
    position: absolute; top: 10px; right: 10px;
    background: rgba(255,255,255,0.9); padding: 5px; border-radius: 8px; border: 1px solid #ccc; pointer-events: none;
}
.hud div { font-size: 12px; font-family: monospace; margin-bottom: 2px; color: #333; }
.hud b { color: var(--primary); }

/* Zoom Buttons */
.zoom-controls {
    position: absolute; bottom: 20px; right: 20px; display: flex; flex-direction: column; gap: 8px;
}
.zoom-controls button {
    width: 40px; height: 40px; border-radius: 50%; border: 1px solid #ccc;
    background: white; font-size: 20px; font-weight: bold; color: #333;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1); cursor: pointer;
}
.zoom-controls button:active { background: #eee; transform: scale(0.95); }

/* Bottom Controls */
.bottom-controls { padding: 15px; background: #fff; border-top: 1px solid #eee; }
input[type=range] { width: 100%; margin: 10px 0 20px; cursor: pointer; height: 25px; accent-color: var(--primary); }
details { background: #f8fafc; padding: 8px; border-radius: 8px; border: 1px solid #e2e8f0; }
summary { font-size: 12px; font-weight: bold; color: #64748b; text-align: center; cursor: pointer; }
.manual-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px; }
.manual-grid label { font-size: 12px; display: flex; align-items: center; gap: 5px; }
.manual-grid input { width: 100%; padding: 5px; border: 1px solid #ccc; border-radius: 4px; }

/* Feedback & Win */
.feedback-bar {
    position: absolute; bottom: 80px; left: 50%; transform: translateX(-50%);
    background: rgba(0,0,0,0.8); color: white; padding: 5px 15px;
    border-radius: 20px; font-size: 12px; opacity: 0; transition: 0.3s; pointer-events: none;
}
.win-modal {
    position: absolute; top:0; left:0; right:0; bottom:0;
    background: rgba(255,255,255,0.85); display: flex; align-items: center; justify-content: center;
    backdrop-filter: blur(5px); opacity: 0; pointer-events: none; transition: 0.3s; z-index: 50;
}
.win-modal.show { opacity: 1; pointer-events: all; }
.win-content {
    background: white; padding: 30px; border-radius: 20px; text-align: center;
    box-shadow: 0 10px 40px rgba(0,0,0,0.2); border: 3px solid var(--accent); animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.win-content h1 { margin: 0 0 10px; color: #16a34a; }
.win-content button {
    background: var(--primary); color: white; border: none; padding: 10px 20px;
    border-radius: 8px; font-size: 16px; margin-top: 15px; cursor: pointer;
}

@keyframes popIn { from { transform: scale(0.5); } to { transform: scale(1); } }
